{
    "compilerOptions": {
        "target": "ES2022",
        "module": "CommonJS",
        "strict": true,

        "esModuleInterop": true,

        "resolveJsonModule": true,

        "skipLibCheck": true,

        "forceConsistentCasingInFileNames": true,

        "noEmit": true,

        "types": [
            "node",
            "@playwright/test"
        ]
    },

    "include": [
        "src/**/*.ts",
        "playwright.config.ts"
    ],

    "exclude": [
        "node_modules"
    ]
}